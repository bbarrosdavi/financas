# Copie para .env (nunca entra no git). Gere os segredos com: openssl rand -hex 32
API_KEY=
WEB_PASSWORD=
SESSION_SECRET=
# Onde o docker-compose publica a porta (IP:porta). Para o celular chegar, use o IP da sua VPN ou da LAN.
PORTA=127.0.0.1:8095
# Endereço do site como o celular o vê: vai no link dos avisos e na tela Ajustes > Celular.
URL_PUBLICA=http://localhost:8095
# Seu nome como o banco escreve no Pix (ex.: FULANO DE TAL): Pix vindo dele é transferência entre contas suas.
TITULAR=
